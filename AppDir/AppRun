#!/usr/bin/env bash
# AppImage entry: start Rezeptor GUI. BYOS installer is chosen in the GUI (no terminal prompt).
set -eu
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="$HERE"
export PROJECT_ROOT="$HERE/usr/share/rezeptor"
# Legacy path (pre-rezeptor rename) — only if new tree missing
if [ ! -d "$PROJECT_ROOT" ] && [ -d "$HERE/usr/share/photoshopCClinux" ]; then
    export PROJECT_ROOT="$HERE/usr/share/photoshopCClinux"
fi
# Bundled python only — never fall back to host python3 (Bazzite / immutable).
export PATH="$HERE/python/bin:$HERE/usr/bin:$HERE/runtime/winetricks:$PROJECT_ROOT/core:$PATH"
# Bundled libmspack for pinned cabextract (see scripts/build-appimage.sh).
if [ -d "$HERE/usr/lib" ]; then
    export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
export REZEPTOR_APPIMAGE=1
# Prefer desktop portal when present (pip Qt in AppImage lacks KDEPlasmaPlatformTheme).
if [ -z "${QT_QPA_PLATFORMTHEME:-}" ]; then
    case "${XDG_CURRENT_DESKTOP:-}${KDE_FULL_SESSION:+KDE}" in
        *KDE*|*Plasma*) export QT_QPA_PLATFORMTHEME=xdgdesktopportal ;;
    esac
fi

# Qt xcb platform needs libxcb-cursor.so.0. Prefer the copy bundled under usr/lib;
# if still missing on the host linker path, print multi-distro install hints (GUI cannot start).
_xcb_cursor_ok=0
if [ -e "$HERE/usr/lib/libxcb-cursor.so.0" ] || [ -e "$HERE/usr/lib/libxcb-cursor.so.0.0.0" ]; then
    _xcb_cursor_ok=1
elif ldconfig -p 2>/dev/null | grep -q 'libxcb-cursor\.so\.0'; then
    _xcb_cursor_ok=1
elif [ -e /usr/lib/libxcb-cursor.so.0 ] \
    || [ -e /usr/lib64/libxcb-cursor.so.0 ] \
    || [ -e /usr/lib/x86_64-linux-gnu/libxcb-cursor.so.0 ] \
    || [ -e /lib/x86_64-linux-gnu/libxcb-cursor.so.0 ]; then
    _xcb_cursor_ok=1
fi
if [ "$_xcb_cursor_ok" -ne 1 ]; then
    cat >&2 <<'EOF'
Rezeptor AppImage: libxcb-cursor.so.0 missing (Qt xcb platform).

Install the package for your distro, then re-run this AppImage:

  Debian / Ubuntu / Mint:  sudo apt install libxcb-cursor0
  Arch / CachyOS / Manjaro: sudo pacman -S libxcb-cursor
  Fedora / RHEL:           sudo dnf install libxcb-cursor
  openSUSE:                sudo zypper install libxcb-cursor0

Immutable (Bazzite/Silverblue/…): prefer Flatpak, or install in a writable layer / distrobox.
EOF
    exit 1
fi

APPIMAGE_PYTHON="$HERE/python/bin/python3"
if [ ! -x "$APPIMAGE_PYTHON" ]; then
    echo "Bundled Python missing — rebuild AppImage (scripts/build-appimage.sh)." >&2
    exit 1
fi
if ! "$APPIMAGE_PYTHON" -c "import PyQt6"; then
    echo "Bundled PyQt6 missing or broken — rebuild AppImage." >&2
    exit 1
fi
export PYTHON="$APPIMAGE_PYTHON"

# Optional: pre-seed from env (CI / advanced). Never block on terminal input.
if [ -n "${PHOTOSHOP_INSTALLER_DIR:-}" ] && [ -f "${PHOTOSHOP_INSTALLER_DIR}/Set-up.exe" ]; then
    mkdir -p "$PROJECT_ROOT/photoshop"
    ln -sfn "$PHOTOSHOP_INSTALLER_DIR/Set-up.exe" "$PROJECT_ROOT/photoshop/Set-up.exe" 2>/dev/null || true
fi

# Never cd into the AppImage mount — it is FUSE read-only. Relative writes
# (e.g. qfluentwidgets ./config) then die with Errno 30.
cd "${HOME:-${TMPDIR:-/tmp}}"
if ! "$PYTHON" -c "import PyQt6"; then
    echo "PyQt6 import failed." >&2
    exit 1
fi
exec "$PYTHON" "$PROJECT_ROOT/launcher/launcher.py" "$@"
